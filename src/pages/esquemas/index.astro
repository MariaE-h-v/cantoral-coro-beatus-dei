---
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getLiturgicalBackground } from '../../utils/liturgicalSeason';

const rawSchemes = import.meta.glob('../../content/esquemas/*.md', { eager: true });

const schemes = Object.entries(rawSchemes)
	.map(([file, module]) => {
		const data = (module as any).frontmatter ?? {};
		const slug = path.basename(file, '.md');
		const songs = Array.isArray(data.cantos) ? data.cantos : [];

		return {
			title: data.title ?? slug,
			description:
				data.description ?? 'Esquema de cantos preparado para una celebracion liturgica.',
			tipo: data.tipo ?? 'Celebracion',
			tiempo: data.tiempo ?? 'Sin tiempo',
			tags: Array.isArray(data.tags) ? data.tags : [],
			songCount: songs.length,
			href: `/esquemas/${slug}`,
			background: getLiturgicalBackground(data.tiempo, data.tags),
		};
	})
	.sort((a, b) => a.title.localeCompare(b.title));
---

<Layout
	title="Esquemas de cantos"
	description="Esquemas litúrgicos guardados en Markdown para preparar, consultar y cargar cantos en el separador."
	image="/assets/portada-impresion-cantos.webp"
>
	<div class="schemes-page">
		<section class="schemes-hero">
			<div>
				<p class="schemes-label">Separador del coro</p>
				<h1>Esquemas de cantos</h1>
				<p>
					Modelos listos para organizar la música de una celebración. Cada esquema
					vive como archivo Markdown en el repositorio y puede cargarse en el
					separador del sitio.
				</p>
			</div>
		</section>

		<section class="schemes-section" aria-labelledby="schemes-title">
			<div class="schemes-section-head">
				<div>
					<p class="schemes-label">Biblioteca</p>
					<h2 id="schemes-title">Esquemas disponibles</h2>
				</div>
				<span>{schemes.length} {schemes.length === 1 ? 'esquema' : 'esquemas'}</span>
			</div>

			{schemes.length ? (
				<div class="schemes-grid">
					{schemes.map(scheme => (
						<a
							class:list={['scheme-card', { 'has-background': Boolean(scheme.background) }]}
							style={scheme.background ? `--scheme-card-bg: url("${scheme.background}");` : undefined}
							href={scheme.href}
						>
							<span class="scheme-card-meta">{scheme.tipo}</span>
							<h3>{scheme.title}</h3>
							<p>{scheme.description}</p>
							<div class="scheme-card-badges">
								<span>{scheme.tiempo}</span>
								<span>{scheme.songCount} {scheme.songCount === 1 ? 'canto' : 'cantos'}</span>
							</div>
							<strong>Ver esquema →</strong>
						</a>
					))}
				</div>
			) : (
				<div class="schemes-empty">
					<h2>Aun no hay esquemas guardados.</h2>
					<p>Crea archivos Markdown dentro de <code>src/content/esquemas</code>.</p>
				</div>
			)}
		</section>
	</div>
</Layout>

<style>
	.schemes-page {
		width: min(1160px, calc(100% - 56px));
		margin: 0 auto;
		padding: 42px 0 28px;
		font-family: Inter, system-ui, sans-serif;
	}

	.schemes-hero {
		display: flex;
		min-height: 340px;
		align-items: center;
		overflow: hidden;
		margin-bottom: 28px;
		padding: 36px;
		border-radius: 28px;
		background:
			linear-gradient(90deg, rgba(255, 248, 239, 0.98) 0%, rgba(255, 248, 239, 0.9) 52%, rgba(255, 248, 239, 0.4) 100%),
			url('/assets/portada-impresion-cantos.webp') center / cover no-repeat,
			white;
		border: 1px solid #eee7dc;
		box-shadow: 0 24px 70px rgba(15, 23, 42, 0.07);
	}

	.schemes-hero > div {
		max-width: 720px;
	}

	.schemes-label {
		margin: 0 0 8px;
		color: #b27722;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.schemes-hero h1,
	.schemes-section-head h2,
	.schemes-empty h2 {
		margin: 0;
		color: #171717;
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 500;
		line-height: 1;
	}

	.schemes-hero h1 {
		font-size: clamp(2.6rem, 5vw, 4.6rem);
	}

	.schemes-hero p:not(.schemes-label) {
		margin: 16px 0 0;
		color: #64748b;
		font-size: 1.04rem;
		line-height: 1.75;
	}

	.schemes-section {
		display: grid;
		gap: 20px;
	}

	.schemes-section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
	}

	.schemes-section-head h2 {
		font-size: clamp(2rem, 3vw, 2.8rem);
	}

	.schemes-section-head > span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1rem;
		border-radius: 999px;
		background: white;
		border: 1px solid #f1e4d1;
		color: #7c5c32;
		font-weight: 900;
		box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
	}

	.schemes-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.scheme-card {
		display: flex;
		min-height: 280px;
		flex-direction: column;
		gap: 12px;
		overflow: hidden;
		padding: 22px;
		border-radius: 24px;
		background: white;
		border: 1px solid #eee7dc;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 18px 54px rgba(15, 23, 42, 0.07);
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.scheme-card.has-background {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 250, 244, 0.88)),
			var(--scheme-card-bg) center / cover no-repeat,
			white;
	}

	.scheme-card:hover {
		border-color: rgba(178, 119, 34, 0.32);
		box-shadow: 0 24px 64px rgba(15, 23, 42, 0.1);
		transform: translateY(-2px);
	}

	.scheme-card-meta {
		width: fit-content;
		padding: 0.36em 0.76em;
		border-radius: 999px;
		background: #fff7ed;
		border: 1px solid #f1e4d1;
		color: #8f5417;
		font-size: 0.76rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.scheme-card h3 {
		margin: 0;
		color: #111827;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.55rem;
		font-weight: 500;
		line-height: 1.08;
	}

	.scheme-card p {
		margin: 0;
		color: #64748b;
		line-height: 1.65;
	}

	.scheme-card-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: auto;
	}

	.scheme-card-badges span {
		padding: 0.34em 0.72em;
		border-radius: 999px;
		background: #f8fafc;
		border: 1px solid #e5e7eb;
		color: #475569;
		font-size: 0.82rem;
		font-weight: 800;
	}

	.scheme-card strong {
		color: #b27722;
		font-weight: 900;
	}

	.schemes-empty {
		padding: 28px;
		border-radius: 22px;
		background: #fffaf4;
		border: 1px dashed #d8c8af;
		color: #64748b;
		line-height: 1.6;
	}

	.schemes-empty h2 {
		margin-bottom: 8px;
		font-size: 1.6rem;
	}

	.schemes-empty p {
		margin: 0;
	}

	.schemes-empty code {
		color: #8f5417;
		font-weight: 800;
	}

	@media (max-width: 980px) {
		.schemes-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.schemes-page {
			width: min(100% - 32px, 1160px);
			padding-top: 28px;
		}

		.schemes-hero {
			min-height: 330px;
			padding: 24px;
			border-radius: 22px;
			background:
				linear-gradient(180deg, rgba(255, 248, 239, 0.98) 0%, rgba(255, 248, 239, 0.94) 64%, rgba(255, 248, 239, 0.78) 100%),
				url('/assets/portada-impresion-cantos.webp') center / cover no-repeat,
				white;
		}

		.schemes-section-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.schemes-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
