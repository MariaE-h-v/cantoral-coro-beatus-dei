---
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';

const rawSongs = import.meta.glob('../../content/cantos/*.md', { eager: true });

const normalize = (value: unknown) =>
	String(value ?? '')
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[-_]+/g, ' ')
		.toLowerCase()
		.trim();

const songs = Object.entries(rawSongs)
	.map(([file, module]) => {
		const data = (module as any).frontmatter ?? {};
		const slug = path.basename(file, '.md');
		const tags = Array.isArray(data.tags) ? data.tags : [];

		return {
			title: data.title ?? slug,
			indice: data.indice ?? '',
			categoria: data.categoria ?? 'Canto',
			tipo: data.tipo ?? 'Canto',
			tiempo: data.tiempo ?? '',
			author: data.author ?? 'Autor desconocido',
			description: data.description ?? 'Canto disponible para consulta dentro del cantoral.',
			tags,
			href: `/cantos/${slug}`,
		};
	})
	.sort((a, b) => a.title.localeCompare(b.title));

const songValues = (song: typeof songs[number]) => [
	song.indice,
	song.title,
	song.description,
	song.tipo,
	song.categoria,
	song.tiempo,
	song.author,
	...song.tags,
];

const scoreSong = (song: typeof songs[number], terms: string[], fallback = false) => {
	const normalizedTerms = terms.map(term => normalize(term)).filter(Boolean);
	const normalizedValues = songValues(song).map(value => normalize(value));
	const primaryValues = [song.tiempo, song.tipo].map(value => normalize(value));
	const tagValues = song.tags.map(tag => normalize(tag));
	let score = 0;

	for (const term of normalizedTerms) {
		if (primaryValues.some(value => value === term)) score += fallback ? 12 : 24;
		if (tagValues.some(value => value === term)) score += fallback ? 10 : 20;
		if (normalizedValues.some(value => value === term)) score += fallback ? 6 : 12;
		if (normalizedValues.some(value => value.includes(term))) score += fallback ? 3 : 8;
	}

	return score;
};

const marriageSongTerms = ['Matrimonio', 'Boda'];
const fallbackSongTerms = [
	'Amor',
	'Familia',
	'Alianza',
	'Donde hay amor',
	'Ubi Caritas',
	'Eucaristía',
	'Ofertorio',
	'Comunión',
];

const directSongMatches = songs
	.map(song => ({ song, score: scoreSong(song, marriageSongTerms) }))
	.filter(result => result.score > 0);

const relatedSongs = (directSongMatches.length
	? directSongMatches
	: songs
			.map(song => ({ song, score: scoreSong(song, fallbackSongTerms, true) }))
			.filter(result => result.score > 0))
	.sort((a, b) => b.score - a.score || a.song.title.localeCompare(b.song.title))
	.slice(0, 12)
	.map(result => result.song);

