---

<Layout
	title="Guía de Matrimonio para el coro"
	description="Guía litúrgica y musical para preparar cantos en el Sacramento del Matrimonio, con criterios, orden de la Misa, salmos, lecturas y repertorio sugerido."
	image="/assets/matrimonio-guia-hero.png"
	canonical="/tipos-de-misas/matrimonio"
	type="article"
	jsonLd={jsonLd}
>
	<main class="marriage-page">
		<section class="marriage-hero" data-parallax>
			<img
				class="marriage-hero-bg"
				src="/assets/matrimonio-guia-hero.png"
				alt=""
				loading="eager"
				data-parallax-layer
				data-speed="0.09"
			/>
			<div class="marriage-hero-shade"></div>
			<div class="marriage-hero-copy" data-reveal>
				<a class="back-link" href="/tipos-de-misas">Tipos de Misas</a>
				<p class="eyebrow">Guía para el coro</p>
				<h1>Sacramento del Matrimonio</h1>
				<p>
					Una guía para elegir cantos que expresen alianza, fidelidad, entrega,
					Eucaristía y la vocación de amar como Cristo ama a su Iglesia.
				</p>
				<div class="hero-actions">
					<a href="#cantos-matrimonio">Ver cantos</a>
					<a href="#esquemas-nupciales">Ver esquemas</a>
				</div>
			</div>
			<div class="sacrament-strip" aria-label="Centro litúrgico de la celebración" data-reveal>
				{sacramentCenter.map(item => <span>{item}</span>)}
			</div>
		</section>

		<section class="marriage-intro">
			<div class="intro-copy" data-reveal>
				<p class="eyebrow">Sentido sacramental</p>
				<h2>No es sólo una ceremonia romántica</h2>
				<p>
					El coro sirve a la celebración de un sacramento. La música no debe girar
					alrededor de la fotografía, la entrada de la novia o una canción favorita,
					sino alrededor del consentimiento, la alianza nupcial, la bendición y la
					Eucaristía cuando hay Misa.
				</p>
			</div>

			<div class="intro-image-wrap" data-parallax data-reveal>
				<img
					src="/assets/matrimonio-guia-coro.png"
					alt="Anillos de matrimonio junto a un crucifijo y una partitura"
					loading="lazy"
					data-parallax-layer
					data-speed="-0.05"
				/>
			</div>
		</section>

		<section class="language-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Lenguaje musical</p>
				<h2>Lo que debe escucharse</h2>
			</div>
			<div class="language-grid">
				{musicLanguage.map(item => <span data-reveal>{item}</span>)}
			</div>
		</section>

		<section class="forms-grid" aria-label="Formas de celebrar el Matrimonio">
			{celebrationForms.map(form => (
				<article data-reveal>
					<span></span>
					<h2>{form.title}</h2>
					<p>{form.text}</p>
				</article>
			))}
		</section>

		<section class="order-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Orden musical</p>
				<h2>Matrimonio dentro de la Misa</h2>
			</div>

			<div class="order-list">
				{massOrder.map(item => (
					<article data-reveal>
						<h3>{item.moment}</h3>
						<p>{item.note}</p>
					</article>
				))}
			</div>
		</section>

		<section class="moment-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Discernimiento</p>
				<h2>Momentos que piden especial cuidado</h2>
			</div>

			<div class="moment-grid">
				{keyMoments.map(moment => (
					<article data-reveal>
						<h3>{moment.title}</h3>
						<p>{moment.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="psalm-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Palabra cantada</p>
				<h2>Salmos apropiados para Matrimonio</h2>
				<p>
					El Salmo responsorial no es un canto intermedio: es Palabra de Dios.
					Conviene pedir las lecturas antes de cerrar el repertorio.
				</p>
			</div>

			<div class="psalm-grid">
				{psalms.map(psalm => (
					<article data-reveal>
						<h3>{psalm.title}</h3>
						<p>{psalm.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="antiphon-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Antífonas propias</p>
				<h2>Formularios A, B y C</h2>
			</div>

			<div class="antiphon-list">
				{antiphons.map(form => (
					<article data-reveal>
						<h3>{form.title}</h3>
						<p>{form.entry}</p>
						<strong>{form.communion}</strong>
					</article>
				))}
			</div>
		</section>

		<section class="reading-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Lecturas</p>
				<h2>La música debe dialogar con la Palabra</h2>
			</div>

			<div class="reading-grid">
				{readings.map(reading => (
					<article data-reveal>
						<h3>{reading.title}</h3>
						<p>{reading.text}</p>
					</article>
				))}
			</div>
		</section>

		<section id="cantos-matrimonio" class="marriage-songs">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Cantoral</p>
				<h2>Cantos relacionados</h2>
			</div>

			{relatedSongs.length ? (
				<div class="song-card-grid">
					{relatedSongs.map(song => (
						<a class="song-card" href={song.href} data-reveal>
							<div>
								{song.indice ? <span>{song.indice}</span> : null}
								<p>{song.categoria}</p>
							</div>
							<h3>{song.title}</h3>
							<p>{song.description}</p>
							<small>{song.author}</small>
						</a>
					))}
				</div>
			) : (
				<p class="empty-state" data-reveal>
					Aún no hay cantos marcados para Matrimonio en el cantoral.
				</p>
			)}
		</section>

		<section class="authors-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Repertorio</p>
				<h2>Autores y estilos útiles</h2>
			</div>

			<div class="authors-grid">
				{authors.map(author => (
					<article data-reveal>
						<h3>{author.name}</h3>
						<p>{author.text}</p>
					</article>
				))}
			</div>
		</section>

		<section id="esquemas-nupciales" class="scheme-section">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Planeación</p>
				<h2>Tres esquemas nupciales</h2>
			</div>

			<div class="scheme-grid">
				{schemes.map(scheme => (
					<article data-reveal>
						<h3>{scheme.title}</h3>
						<ul>
							{scheme.items.map(item => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="priority-section">
			<div data-reveal>
				<p class="eyebrow">Ensayo</p>
				<h2>Si hay poco tiempo, ensaya en este orden</h2>
				<p>
					Primero debe estar bien cantada la propia liturgia; después se embellecen
					los momentos complementarios.
				</p>
			</div>

			<ol data-reveal>
				{priorities.map(priority => <li>{priority}</li>)}
			</ol>
		</section>

		<section class="avoid-section" data-reveal>
			<div>
				<p class="eyebrow">Criterio de oro</p>
				<h2>Lo que conviene evitar</h2>
				<p>
					No se trata de rechazar canciones bonitas, sino de reservar cada música
					para el lugar donde verdaderamente sirve al rito.
				</p>
			</div>

			<ul>
				{avoidSongs.map(song => <li>{song}</li>)}
			</ul>
		</section>

		<section class="theology-section" data-reveal>
			<p class="eyebrow">Idea central</p>
			<h2>Del “nos amamos” al “Dios nos llama”</h2>
			<p>
				Un repertorio matrimonial verdaderamente católico conduce a algo más grande:
				Dios nos ha llamado a amarnos como Cristo ama a su Iglesia. La entrada,
				la Palabra, el consentimiento, los anillos, el ofertorio, la Eucaristía,
				la Comunión y la bendición nupcial pueden cantar ese recorrido sin perder
				el centro sacramental.
			</p>
		</section>

		<section class="sources-section" data-reveal>
			<p class="eyebrow">Fuentes de consulta</p>
			<div>
				{sourceLinks.map(source => (
					<a href={source.href} target="_blank" rel="noreferrer">{source.label}</a>
				))}
			</div>
		</section>
	</main>
</Layout>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const parallaxLayers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax-layer]'));

	const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

	const updateParallax = () => {
		if (reduceMotion.matches) return;

		parallaxLayers.forEach(layer => {
			const section = layer.closest<HTMLElement>('[data-parallax]');
			if (!section) return;

			const rect = section.getBoundingClientRect();
			const speed = Number(layer.dataset.speed ?? '0.08');
			const sectionMidpoint = rect.top + rect.height / 2;
			const viewportMidpoint = window.innerHeight / 2;
			const offset = clamp((viewportMidpoint - sectionMidpoint) * speed, -70, 70);

			layer.style.setProperty('--parallax-y', `${offset}px`);
		});
	};

	let ticking = false;

	const requestParallax = () => {
		if (ticking) return;
		ticking = true;
		window.requestAnimationFrame(() => {
			updateParallax();
			ticking = false;
		});
	};

	const revealObserver = new IntersectionObserver(
		entries => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					revealObserver.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.16 }
	);

	document.querySelectorAll('[data-reveal]').forEach(element => {
		revealObserver.observe(element);
	});

	updateParallax();
	window.addEventListener('scroll', requestParallax, { passive: true });
	window.addEventListener('resize', requestParallax);
</script>

